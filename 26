class ContainerTab(ttk.Frame):
    def __init__(self, master, app):
        super().__init__(master)
        self.app = app
        self.buf_alt = SeriesBuffer()
        self.buf_temp = SeriesBuffer()
        self.buf_curr = SeriesBuffer()
        self.text_vars = {f: tk.StringVar(value="--") for f in CONTAINER_FIELDS}

        self._build_ui()

    def _build_ui(self):
        left = ttk.Frame(self)
        left.pack(side="left", fill="both", expand=True)
        right = ttk.Frame(self, width=340)
        right.pack(side="right", fill="y")
        right.pack_propagate(False)

        # --- Gráficas requeridas explícitamente por GS2 ---
        self.fig, self.axes = plt.subplots(3, 1, figsize=(6.5, 7), sharex=True)
        self.fig.subplots_adjust(hspace=0.5)
        titles = ["Altitud (m)", "Temperatura (C)", "Corriente Batería (mA)"]
        self.lines = []
        for ax, title in zip(self.axes, titles):
            ax.set_title(title)
            ax.grid(True, alpha=0.4)
            (line,) = ax.plot([], [], color="#1a4fa0")
            self.lines.append(line)
        self.axes[-1].set_xlabel("Tiempo de misión (s)")

        self.canvas = FigureCanvasTkAgg(self.fig, master=left)
        self.canvas.get_tk_widget().pack(fill="both", expand=True)

        # --- Panel de texto: resto de telemetría (GS3) ---
        ttk.Label(right, text="Container - Telemetría", font=FONT_BOLD).pack(
            anchor="w", padx=8, pady=(10, 6))
        grid = ttk.Frame(right)
        grid.pack(fill="x", padx=8)
        labels = {
            "ID": "ID", "MISSION_TIME": "T. misión (s)",
            "PACKET_COUNT": "Paq. TX (#)", "COMMAND_COUNT": "Cmds recibidos",
            "MODE": "Modo", "PRESSURE": "Presión (Pa)",
            "MECH_STATE": "Estado mecanismos", "STATE": "Estado de vuelo",
            "CMD_ECHO": "Último comando",
        }
        for i, (field, label) in enumerate(labels.items()):
            ttk.Label(grid, text=label + ":", font=FONT_MAIN).grid(
                row=i, column=0, sticky="w", pady=3)
            ttk.Label(grid, textvariable=self.text_vars[field],
                      font=FONT_MONO, foreground="#003366").grid(
                row=i, column=1, sticky="w", padx=(6, 0))

        ttk.Separator(right).pack(fill="x", pady=12, padx=8)

        # Contador de paquetes recibidos en la estación terrena (GS11)
        ttk.Label(right, text="Paquetes recibidos (GS):", font=FONT_MAIN).pack(
            anchor="w", padx=8)
        self.rx_count_var = tk.StringVar(value="0")
        ttk.Label(right, textvariable=self.rx_count_var, font=FONT_BOLD,
                  foreground="#006600").pack(anchor="w", padx=8)

    def update_telemetry(self, row: dict, mission_start_disp):
        t = safe_float(row.get("MISSION_TIME"))
        self.buf_alt.add(t, safe_float(row.get("ALTITUDE")))
        self.buf_temp.add(t, safe_float(row.get("TEMPERATURE")))
        self.buf_curr.add(t, safe_float(row.get("BATT_I")))

        for buf, line, ax in zip(
            [self.buf_alt, self.buf_temp, self.buf_curr], self.lines, self.axes
        ):
            line.set_data(buf.t, buf.y)
            ax.relim()
            ax.autoscale_view()
        self.canvas.draw_idle()

        for f in CONTAINER_FIELDS:
            if f in row:
                self.text_vars[f].set(row[f])

        self.rx_count_var.set(str(int(self.rx_count_var.get()) + 1))


