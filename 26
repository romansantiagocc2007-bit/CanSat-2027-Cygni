def parse_csv_line(line: str, expected_fields):
    """Convierte una línea CSV recibida por radio en un diccionario.
    Ignora líneas que no tengan al menos el número mínimo de campos."""
    parts = [p.strip() for p in line.strip().split(",")]
    if len(parts) < len(expected_fields):
        # Rellenar campos faltantes (p.ej. IMAGE_STABILIZATION/SCIENCE_EXP
        # que tienen largo variable) para no romper el parseo
        parts += [""] * (len(expected_fields) - len(parts))
    return dict(zip(expected_fields, parts[:len(expected_fields)]))


def safe_float(value, default=0.0):
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


# ---------------------------------------------------------------------------
# Capa de radio (interfaz abstracta + backend de demostración)
# ---------------------------------------------------------------------------

class RadioInterface:
    """Interfaz que debe implementar el enlace real (ESPNOW / XBEE).
    Reemplazar `DemoRadio` por una clase que hable con el hardware real,
    manteniendo esta misma interfaz para no modificar el resto de la UI."""

    def connect(self, channel: str, peer_mac: str):
        raise NotImplementedError

    def disconnect(self):
        raise NotImplementedError

    def send_command(self, target: str, command: str):
        """target: 'CONTAINER' o 'POCKETQUBE'"""
        raise NotImplementedError

    def set_rx_callback(self, callback):
        """callback(source:str, raw_line:str) se llama por cada paquete."""
        raise NotImplementedError


class DemoRadio(RadioInterface):
    """Backend de demostración: genera telemetría sintética a 4 Hz para
    poder probar la interfaz sin hardware. NO usar en vuelo real."""

    def __init__(self):
        self._running = False
        self._thread = None
        self._callback = None
        self._t0 = None
        self._pkt_c = 0
        self._pkt_p = 0
        self._cmd_count = 0
        self._sim_mode = False

    def connect(self, channel: str, peer_mac: str):
        self._running = True
        self._t0 = time.time()
        self._thread = threading.Thread(target=self._loop, daemon=True)
        self._thread.start()

    def disconnect(self):
        self._running = False

    def set_rx_callback(self, callback):
        self._callback = callback

    def send_command(self, target: str, command: str):
        self._cmd_count += 1
        if command.startswith("SIM"):
            if "ACTIVATE" in command:
                self._sim_mode = True
            if command.strip() == "SIM FLIGHT" or "DISABLE" in command:
                self._sim_mode = False

    def _loop(self):
        while self._running:
            t = time.time() - self._t0
            self._pkt_c += 1
            self._pkt_p += 1
            alt = max(0.0, 300 * math.sin(t / 20) + 300)
            container_row = [
                "1000C", f"{t:.3f}", str(self._pkt_c), str(self._cmd_count),
                "S" if self._sim_mode else "F", f"{alt:.1f}",
                f"{101325 - alt*11:.0f}", f"{22 + random.uniform(-0.3,0.3):.1f}",
                f"{7.4 + random.uniform(-0.05,0.05):.2f}",
                f"{120 + random.uniform(-5,5):.0f}", "0", "ASCENT", "CXON",
            ]
            pq_row = [
                "1000P", "S" if self._sim_mode else "F", f"{t:.3f}",
                str(self._pkt_p), str(self._cmd_count),
                f"{alt*0.98:.1f}", f"{21 + random.uniform(-0.3,0.3):.1f}",
                f"{101325 - alt*11:.0f}", f"{4.1 + random.uniform(-0.05,0.05):.2f}",
                f"{80 + random.uniform(-5,5):.0f}",
                datetime.now(timezone.utc).strftime("%H%M%S"),
                f"{alt*0.98:.1f}", f"{19.4326 + random.uniform(-0.0005,0.0005):.6f}",
                f"{-99.1332 + random.uniform(-0.0005,0.0005):.6f}", "8",
                f"{random.uniform(-5,5):.1f}", f"{random.uniform(-5,5):.1f}",
                f"{random.uniform(-5,5):.1f}", f"{random.uniform(-1,1):.3f}",
                f"{random.uniform(-1,1):.3f}", f"{9.8+random.uniform(-0.2,0.2):.3f}",
                f"{random.uniform(200,600):.0f}", f"{random.uniform(200,600):.0f}",
                f"{random.uniform(200,600):.0f}",
                f"{3.3+random.uniform(-0.2,0.2):.2f}",
                f"{3.3+random.uniform(-0.2,0.2):.2f}",
                "F", "SPROT090", "OK", "",
            ]
            if self._callback:
                self._callback("CONTAINER", ",".join(container_row))
                self._callback("POCKETQUBE", ",".join(pq_row))
            time.sleep(0.25)  # 4 Hz


# ---------------------------------------------------------------------------
# Buffer de series para graficar (ventana deslizante)
# ---------------------------------------------------------------------------

class SeriesBuffer:
    def __init__(self, maxlen=MAX_POINTS):
        self.t = deque(maxlen=maxlen)
        self.y = deque(maxlen=maxlen)

    def add(self, t, y):
        self.t.append(t)
        self.y.append(y)


# ---------------------------------------------------------------------------
# Escritor de CSV (Requisito GS13 - Flight_<TEAM>C.csv / Flight_<TEAM>P.csv)
# ---------------------------------------------------------------------------

class TelemetryLogger:
    def __init__(self, team_id_var, suffix, fieldnames):
        self.team_id_var = team_id_var
        self.suffix = suffix
        self.fieldnames = fieldnames
        self._file = None
        self._writer = None
        self.active = False
        self.row_count = 0

    def start(self):
        team = self.team_id_var.get().strip() or "0000"
        filename = f"Flight_{team}{self.suffix}.csv"
        self._file = open(filename, "w", newline="", encoding="utf-8")
        self._writer = csv.writer(self._file)
        self._writer.writerow(self.fieldnames)
        self.active = True
        self.row_count = 0
        return filename

    def write(self, row_dict):
        if self.active and self._writer:
            self._writer.writerow([row_dict.get(f, "") for f in self.fieldnames])
            self.row_count += 1

    def stop(self):
        self.active = False
        if self._file:
            self._file.flush()
            self._file.close()
        self._file = None
        self._writer = None


