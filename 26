class GroundStationApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Estación Terrena - CanSat 2027 (PocketQube) - Borrador")
        self.geometry("1180x760")
        self.configure(bg=BG_LIGHT)

        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass
        style.configure(".", background=BG_LIGHT, foreground=FG_DARK,
                         font=FONT_MAIN)
        style.configure("TNotebook.Tab", font=FONT_BOLD, padding=(14, 8))
        style.configure("TLabelframe.Label", font=FONT_BOLD)

        self.team_id_var = tk.StringVar(value="1000")
        self.log_status_var = None  # asignado por ConfigTab

        self.radio = DemoRadio()
        self.radio.set_rx_callback(self._on_radio_rx)

        self.container_logger = TelemetryLogger(self.team_id_var, "C", CONTAINER_FIELDS)
        self.pocketqube_logger = TelemetryLogger(self.team_id_var, "P", POCKETQUBE_FIELDS)

        self._build_ui()

    def _build_ui(self):
        notebook = ttk.Notebook(self)
        notebook.pack(fill="both", expand=True, padx=6, pady=6)

        self.container_tab = ContainerTab(notebook, self)
        self.pocketqube_tab = PocketQubeTab(notebook, self)
        self.commands_tab = CommandsTab(notebook, self)
        self.config_tab = ConfigTab(notebook, self)

        notebook.add(self.container_tab, text="  Container  ")
        notebook.add(self.pocketqube_tab, text="  PocketQube  ")
        notebook.add(self.commands_tab, text="  Comandos y Simulación  ")
        notebook.add(self.config_tab, text="  Configuración  ")

        status = ttk.Frame(self)
        status.pack(fill="x", side="bottom")
        ttk.Label(status, text="Equipo:", font=FONT_MAIN).pack(side="left", padx=(10, 2))
        ttk.Label(status, textvariable=self.team_id_var, font=FONT_BOLD).pack(side="left")

    # --- Recepción de telemetría (llamado desde el hilo de radio) ---
    def _on_radio_rx(self, source, raw_line):
        # Se llama desde un hilo de fondo: despachar al hilo principal de Tk
        self.after(0, self._handle_rx, source, raw_line)

    def _handle_rx(self, source, raw_line):
        if source == "CONTAINER":
            row = parse_csv_line(raw_line, CONTAINER_FIELDS)
            self.container_tab.update_telemetry(row, None)
            self.container_logger.write(row)
        elif source == "POCKETQUBE":
            row = parse_csv_line(raw_line, POCKETQUBE_FIELDS)
            self.pocketqube_tab.update_telemetry(row)
            self.pocketqube_logger.write(row)

    # --- Registro CSV (GS13) ---
    def start_logging(self):
        fname_c = self.container_logger.start()
        fname_p = self.pocketqube_logger.start()
        if self.log_status_var:
            self.log_status_var.set(f"Registrando en {fname_c} / {fname_p}")

    def stop_logging(self):
        self.container_logger.stop()
        self.pocketqube_logger.stop()
        if self.log_status_var:
            self.log_status_var.set("Registro detenido")


if __name__ == "__main__":
    app = GroundStationApp()
    app.mainloop()
