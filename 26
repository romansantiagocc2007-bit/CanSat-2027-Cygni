                                 bg="#ffffff", fg=FG_DARK, wrap="word")
        self.log_text.pack(fill="both", expand=True)

    def _log(self, msg):
        ts = datetime.now().strftime("%H:%M:%S")
        self.log_text.insert("end", f"[{ts}] {msg}\n")
        self.log_text.see("end")

    def _send(self, cmd):
        cmd = cmd.strip()
        if not cmd:
            return
        target = self.target_var.get()
        self.app.radio.send_command(target, cmd)
        self._log(f"TX -> {target}: {cmd}")

    def _sim_enable(self):
        for target in ("CONTAINER", "POCKETQUBE"):
            self.app.radio.send_command(target, "SIM ENABLE")
        self._log("TX -> CONTAINER/POCKETQUBE: SIM ENABLE")

    def _sim_activate(self):
        for target in ("CONTAINER", "POCKETQUBE"):
            self.app.radio.send_command(target, "SIM ACTIVATE")
        self._log("TX -> CONTAINER/POCKETQUBE: SIM ACTIVATE")

    def _load_profile(self):
        path = filedialog.askopenfilename(
            title="Seleccionar archivo de perfil de presión",
            filetypes=[("CSV / texto", "*.csv *.txt"), ("Todos", "*.*")])
        if not path:
            return
        values = []
        try:
            with open(path, newline="", encoding="utf-8") as f:
                reader = csv.reader(f)
                for row in reader:
                    if not row:
                        continue
                    try:
                        values.append(float(row[0]))
                    except ValueError:
                        continue  # posible encabezado
        except Exception as e:
            messagebox.showerror("Error al leer archivo", str(e))
            return

        if not values:
            messagebox.showwarning("Archivo vacío",
                                    "No se encontraron valores numéricos de presión.")
            return

        self.sim_profile = values
        self.profile_status_var.set(f"{len(values)} muestras cargadas")
        self.sim_progress.configure(maximum=len(values), value=0)
        self._log(f"Perfil de presión cargado: {len(values)} muestras desde {path}")

    # --- Envío de SIMP a 1 Hz, en un hilo aparte para no bloquear la UI ---
    def _start_sim(self):
        if not self.sim_profile:
            messagebox.showwarning("Sin perfil",
                                    "Primero carga un archivo de perfil de presión.")
            return
        if self.sim_running:
            return
        self.sim_running = True
        self.btn_sim_start.configure(state="disabled")
        self.btn_sim_stop.configure(state="normal")
        self._log("Simulación iniciada: enviando SIMP a 1 Hz")
        self.sim_thread = threading.Thread(target=self._sim_loop, daemon=True)
        self.sim_thread.start()

    def _stop_sim(self):
        self.sim_running = False
        self.btn_sim_start.configure(state="normal")
        self.btn_sim_stop.configure(state="disabled")
        self._log("Simulación detenida por el usuario")

    def _sim_loop(self):
        total = len(self.sim_profile)
        for i, pressure in enumerate(self.sim_profile):
            if not self.sim_running:
                break
            cmd = f"SIMP {pressure:.0f}"
            for target in ("CONTAINER", "POCKETQUBE"):
                self.app.radio.send_command(target, cmd)
            # Actualizaciones de UI deben hacerse en el hilo principal
            self.after(0, self._update_sim_progress, i + 1, total, pressure)
            time.sleep(1.0)  # Requisito GS8: 1 muestra por segundo
        self.sim_running = False
        self.after(0, lambda: self.btn_sim_start.configure(state="normal"))
        self.after(0, lambda: self.btn_sim_stop.configure(state="disabled"))
        self.after(0, lambda: self._log("Simulación finalizada"))

    def _update_sim_progress(self, i, total, pressure):
        self.sim_progress_var.set(
            f"Muestra: {i} / {total}   Presión enviada: {pressure:.0f} Pa")
        self.sim_progress.configure(value=i)


