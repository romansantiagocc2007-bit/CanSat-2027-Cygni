    def update_telemetry(self, row: dict):
        t = safe_float(row.get("MISSION_TIME"))
        self.buf_alt.add(t, safe_float(row.get("ALTITUDE")))
        self.buf_temp.add(t, safe_float(row.get("TEMPERATURE")))
        self.buf_volt.add(t, safe_float(row.get("VOLTAGE")))
        self.buf_curr.add(t, safe_float(row.get("CURRENT")))
        self.buf_rot_x.add(t, safe_float(row.get("ROT_RATE_X")))
        self.buf_rot_y.add(t, safe_float(row.get("ROT_RATE_Y")))
        self.buf_rot_z.add(t, safe_float(row.get("ROT_RATE_Z")))
        self.buf_solar1.add(t, safe_float(row.get("SOLAR_1")))
        self.buf_solar2.add(t, safe_float(row.get("SOLAR_2")))

        self.line_alt.set_data(self.buf_alt.t, self.buf_alt.y)
        self.line_temp.set_data(self.buf_temp.t, self.buf_temp.y)
        self.line_v.set_data(self.buf_volt.t, self.buf_volt.y)
        self.line_i.set_data(self.buf_curr.t, self.buf_curr.y)
        self.line_rx.set_data(self.buf_rot_x.t, self.buf_rot_x.y)
        self.line_ry.set_data(self.buf_rot_y.t, self.buf_rot_y.y)
        self.line_rz.set_data(self.buf_rot_z.t, self.buf_rot_z.y)
        self.line_s1.set_data(self.buf_solar1.t, self.buf_solar1.y)
        self.line_s2.set_data(self.buf_solar2.t, self.buf_solar2.y)

        for ax in [self.ax_alt, self.ax_temp, self.ax_v, self.ax_i,
                   self.ax_rot, self.ax_solar]:
            ax.relim()
            ax.autoscale_view()
        self.canvas.draw_idle()

        lat = safe_float(row.get("GNSS_LATITUDE"), None)
        lon = safe_float(row.get("GNSS_LONGITUDE"), None)
        if lat and lon:
            self.gps_lat.append(lat)
            self.gps_lon.append(lon)
            self.gps_line.set_data(self.gps_lon, self.gps_lat)
            self.gps_ax.relim()
            self.gps_ax.autoscale_view()
            self.gps_canvas.draw_idle()

        for f in POCKETQUBE_FIELDS:
            if f in row:
                self.text_vars[f].set(row[f])

        self.rx_count_var.set(str(int(self.rx_count_var.get()) + 1))


